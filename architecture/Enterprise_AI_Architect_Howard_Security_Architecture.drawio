        <mxCell id="banner_p1_overview_101" value="&lt;div style=&#x27;font-size:16px; font-weight:bold; color:#78350F;&#x27;&gt;企業級 AI 平台與 Howard 資安防禦全域架構圖&lt;/div&gt;&lt;div style=&#x27;font-size:11px; color:#92400E; margin-top:3px;&#x27;&gt;整合 Enterprise GPT、AI Agent Platform、地端 AIDC、Howard Prisma AIRS 與後量子密碼防線 ｜ &lt;b&gt;架構與策略總設計：Howard Liao Ph.D.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1420" height="65" as="geometry" /></mxCell>
        <mxCell id="lane_p1_overview_102" value="&lt;b&gt;【使用者與全通路上層業務場景】Consumers, Operations &amp;amp; Corporate Departments&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0369A1;fontSize=12;rounded=1;collapsible=0;startSize=28;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="1420" height="170" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_103" value="全通路數位入口 Web / App&#xa;• 消費者端 AI 購物助手&#xa;• 智慧搜尋與個人化推薦" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_102"><mxGeometry x="20" y="42" width="215" height="110" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_104" value="企業內部營運場景&#xa;• HR 人資行政審核 Agent&#xa;• 財務報銷自動化 Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_102"><mxGeometry x="255" y="42" width="215" height="110" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_105" value="電商營運與智慧物流&#xa;• 庫存水位智慧預測&#xa;• 智慧物流派件調度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_102"><mxGeometry x="490" y="42" width="215" height="110" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_106" value="智慧客服中心&#xa;• 7x24 全時段對話客服&#xa;• 售後投訴智慧分流處理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_102"><mxGeometry x="725" y="42" width="215" height="110" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_107" value="研發團隊與 AI Developer&#xa;• Cursor / IDE 擴充套件&#xa;• 自動化腳本與工具呼叫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_102"><mxGeometry x="960" y="42" width="215" height="110" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_108" value="非人類身分 (NHI)&#xa;• 自主 Agentic Worker&#xa;• 背景定時批次排程作業" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_102"><mxGeometry x="1195" y="42" width="205" height="110" as="geometry" /></mxCell>
        <mxCell id="lane_p1_overview_109" value="&lt;b&gt;【Howard AI 安全入口與治理層】Howard Prisma AIRS &amp;amp; AI Gateway Hub&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#991B1B;fontSize=12;rounded=1;collapsible=0;startSize=28;" vertex="1" parent="1"><mxGeometry x="50" y="285" width="1420" height="180" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_110" value="&lt;b&gt;Howard Prisma AIRS&lt;/b&gt;&#xa;AI Runtime Security 全生命週期防護&#xa;• 提示詞注入攔截・越獄防禦&#xa;• 客戶隱私個資 (PII) 自動遮蔽去識別" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=1;fontColor=#881337;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_109"><mxGeometry x="20" y="42" width="265" height="120" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_111" value="&lt;b&gt;Howard AI Gateway (Portkey / LiteLLM)&lt;/b&gt;&#xa;多模型動態路由・多租戶隔離&#xa;• 智慧語意快取 (Semantic Cache)&#xa;• 負載平衡與防抖自動降級" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=1;fontColor=#881337;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_109"><mxGeometry x="305" y="42" width="265" height="120" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_112" value="&lt;b&gt;Howard FinOps &amp; Token 治理中樞&lt;/b&gt;&#xa;Token / GPU 即時用量計費 (Chargeback)&#xa;• 部門配額設限 (Resource Quota)&#xa;• 成本效益可視化分析儀表板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=1;fontColor=#881337;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_109"><mxGeometry x="590" y="42" width="265" height="120" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_113" value="&lt;b&gt;Howard NHI 身分與意圖審計中樞&lt;/b&gt;&#xa;機器身分生命週期憑證管理&#xa;• 防代理混淆 (Confused Deputy)&#xa;• 推論鏈 Intent Auditability 存證" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=1;fontColor=#881337;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_109"><mxGeometry x="875" y="42" width="265" height="120" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_114" value="&lt;b&gt;Howard AI 全鏈路可觀測中樞&lt;/b&gt;&#xa;Langfuse + OpenTelemetry 深度整合&#xa;• Latency・Error・Token 全方位追蹤&#xa;• 異常調用即時警報與分流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=1;fontColor=#881337;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_109"><mxGeometry x="1160" y="42" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="lane_p1_overview_115" value="&lt;b&gt;【企業級 AI 核心平台】Enterprise GPT &amp;amp; Agent Platform Ecosystem&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#581C87;fontSize=12;rounded=1;collapsible=0;startSize=28;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="1420" height="185" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_116" value="&lt;b&gt;Enterprise GPT 企業大腦平台&lt;/b&gt;&#xa;企業內部專屬 LLM 互動平台&#xa;• 內部法規 FAQ 與公文自動起草&#xa;• 跨部門知識問答檢索助手" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1;fontColor=#1E293B;fontSize=11;rounded=1;" vertex="1" parent="lane_p1_overview_115"><mxGeometry x="20" y="42" width="265" height="125" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_117" value="&lt;b&gt;AI Agent Workflow 引擎&lt;/b&gt;&#xa;多代理協同架構・任務拆解排程&#xa;• Stateful ReAct / Plan-and-Solve 循環&#xa;• 自動上下文維護與狀態轉移" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1;fontColor=#1E293B;fontSize=11;rounded=1;" vertex="1" parent="lane_p1_overview_115"><mxGeometry x="305" y="42" width="265" height="125" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_118" value="&lt;b&gt;全鏈路 RAG 檢索增強系統&lt;/b&gt;&#xa;多路召回 (語意向量 + 關鍵字重排)&#xa;• 企業級文件智慧解析與切片&#xa;• 商品目錄與制度規章知識庫" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1;fontColor=#1E293B;fontSize=11;rounded=1;" vertex="1" parent="lane_p1_overview_115"><mxGeometry x="590" y="42" width="265" height="125" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_119" value="&lt;b&gt;MCP (Model Context Protocol) 工具中樞&lt;/b&gt;&#xa;標準化外部工具動態調用協定&#xa;• ERP / WMS / CRM / 訂單資料庫介接&#xa;• 權限隔離沙箱與參數校驗" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1;fontColor=#1E293B;fontSize=11;rounded=1;" vertex="1" parent="lane_p1_overview_115"><mxGeometry x="875" y="42" width="265" height="125" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_120" value="&lt;b&gt;模型選型與微調 Pipeline&lt;/b&gt;&#xa;領域專有語意微調 (LoRA / SFT)&#xa;• 開源大模型領域適配 (Domain LLM)&#xa;• 效能評估驗證與基準測試" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1;fontColor=#1E293B;fontSize=11;rounded=1;" vertex="1" parent="lane_p1_overview_115"><mxGeometry x="1160" y="42" width="240" height="125" as="geometry" /></mxCell>
        <mxCell id="lane_p1_overview_121" value="&lt;b&gt;【混合算力與模型推論調度層】Hybrid Cloud &amp;amp; On-Premises AIDC Computing Center&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#065F46;fontSize=12;rounded=1;collapsible=0;startSize=28;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="1420" height="195" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_122" value="&lt;b&gt;公有雲商用模型 API (GCP / AWS)&lt;/b&gt;&#xa;• Google Gemini 2.5 Pro (Vertex AI)&#xa;• Anthropic Claude 3.7 Sonnet (Bedrock)&#xa;• OpenAI GPT-4o / O3 模型端點&#xa;• 支援雙 11 大促突發流量彈性擴容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_121"><mxGeometry x="20" y="42" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_123" value="&lt;b&gt;Kubernetes GPU 調度中樞 (AIDC)&lt;/b&gt;&#xa;• Volcano 智慧排程器 (Priority Queue)&#xa;• NVIDIA MIG 資源切片硬體虛擬化&#xa;• 多租戶命名空間隔離與配額限制&#xa;• 基于 Queue 深度觸發自動擴縮 (HPA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_121"><mxGeometry x="305" y="42" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_124" value="&lt;b&gt;高效能推論服務叢集 (vLLM / Triton)&lt;/b&gt;&#xa;• 開源模型：Llama 3.3 / Qwen / DeepSeek&#xa;• PagedAttention 記憶體快取最佳化&#xa;• Continuous Batching 並行處理&#xa;• FP8 / INT4 模型量化降低推論延遲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_121"><mxGeometry x="590" y="42" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_125" value="&lt;b&gt;地端 AIDC GPU 硬體基礎設施&lt;/b&gt;&#xa;• NVIDIA H100/H200 / AMD MI300X 叢集&#xa;• 400G RoCE v2 GPUDirect RDMA 無損網路&#xa;• NVMe-oF 高速分散式平行檔案系統&#xa;• 資料 100% 地端留存，降低 40% 租賃成本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_121"><mxGeometry x="875" y="42" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_126" value="&lt;b&gt;企業資料中樞與向量儲存&lt;/b&gt;&#xa;• Milvus / Qdrant 高效向量索引&#xa;• Enterprise Lakehouse (BigQuery/S3)&#xa;• 行層級安全 (RLS) 與資料實體隔離&#xa;• 機密資料加密防洩漏防護" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;" vertex="1" parent="lane_p1_overview_121"><mxGeometry x="1160" y="42" width="240" height="135" as="geometry" /></mxCell>
        <mxCell id="lane_p1_overview_127" value="&lt;b&gt;【Howard 端點現代周界、供應鏈防禦與後量子密碼學底座】Enterprise Browser, Supply Chain &amp;amp; Quantum-Safe&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#78350F;fontSize=12;rounded=1;collapsible=0;startSize=28;" vertex="1" parent="1"><mxGeometry x="50" y="890" width="1420" height="195" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_128" value="&lt;b&gt;Howard Enterprise Browser&lt;/b&gt;&#xa;安全企業瀏覽器底座 + Wings AI Risk Engine&#xa;• 保護瀏覽器外掛・IDE 擴充套件安全&#xa;• MCP 外部工具現代軟體周界全面監管&#xa;• 在端點下載前即刻完成封鎖隔離" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_127"><mxGeometry x="20" y="42" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_129" value="&lt;b&gt;Howard 5 階供應鏈防禦鏈&lt;/b&gt;&#xa;阻斷類似 Shai-Hulud 自動化供應鏈投毒&#xa;• 1. 入口攔截 ➔ 2. Runtime 行為防護&#xa;• 3. 憑證保護 ➔ 4. CI/CD 冷卻緩衝 (72h)&#xa;• 5. 持續硬隔離收容爆炸半徑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_127"><mxGeometry x="305" y="42" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_130" value="&lt;b&gt;Howard Dynamic CBOM 清冊&lt;/b&gt;&#xa;全企業密碼技術資產動態清冊&#xa;• 自動盤點加密套件、憑證與金鑰長度&#xa;• AI 評估老舊設備與印表機 PQC 就緒度&#xa;• 動態輸出持續可稽核密碼學地圖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_127"><mxGeometry x="590" y="42" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_131" value="&lt;b&gt;Howard Crypto Agility 四階閉環&lt;/b&gt;&#xa;密碼學敏捷性完整治理落地&#xa;• 1. Howard NGFW 發現 ➔ 2. 多維風險評估&#xa;• 3. 政策自動下發 / 密碼轉譯中繼防護&#xa;• 4. NIST PQC 國際標準合規報告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_127"><mxGeometry x="875" y="42" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_132" value="&lt;b&gt;後量子防禦 (PQC Readiness)&lt;/b&gt;&#xa;防範「先截獲、後解密」(HNDL) 長期危機&#xa;• 符合 NIST FIPS 203/204/205 標準&#xa;• ML-KEM / ML-DSA 後量子演算法支援&#xa;• 確保商業機密與個資 10+ 年抗破譯能力" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=20;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;" vertex="1" parent="lane_p1_overview_127"><mxGeometry x="1160" y="42" width="240" height="135" as="geometry" /></mxCell>
        <mxCell id="lane_p1_overview_133" value="&lt;b&gt;【Infra 平台工程與維運自動化】Platform Engineering, GitOps &amp;amp; SRE Reliability&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontColor=#1E293B;fontSize=12;rounded=1;collapsible=0;startSize=28;" vertex="1" parent="1"><mxGeometry x="50" y="1100" width="1420" height="160" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_134" value="GitOps &amp; 宣告式交付&#xa;• ArgoCD + Terraform 雲地 IaC 部署&#xa;• 基礎設施全版本受控、稽核可追蹤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_133"><mxGeometry x="20" y="42" width="265" height="100" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_135" value="自動化安全 CI/CD 流水線&#xa;• 整合靜態代碼分析 (SAST) 與依賴掃描&#xa;• 漏洞風險門檻強制中斷阻斷機制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_133"><mxGeometry x="305" y="42" width="265" height="100" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_136" value="SRE 智慧維運與告警分流&#xa;• AIOps 根因分析・異常自我修復&#xa;• 智慧降噪與事件自動調查排除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_133"><mxGeometry x="590" y="42" width="265" height="100" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_137" value="業務連續性與災難復原 (BCP)&#xa;• 跨雲資料非同步抄寫・地端機房備援&#xa;• 目標 RTO &amp;lt; 1hr, RPO ≈ 0 營運韌性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_133"><mxGeometry x="875" y="42" width="265" height="100" as="geometry" /></mxCell>
        <mxCell id="card_p1_overview_138" value="雙員工治理與規範手冊&#xa;• 人類員工 vs. 數位員工規則分流管轄&#xa;• 嚴格落實 ISO 27001 / ISO 42001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_p1_overview_133"><mxGeometry x="1160" y="42" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_139" value="HTTPS / User Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#0284C7;" edge="1" parent="1" source="card_p1_overview_103" target="card_p1_overview_110"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_140" value="Sanitized Request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#EF4444;" edge="1" parent="1" source="card_p1_overview_110" target="card_p1_overview_111"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_141" value="Route to Agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#8B5CF6;" edge="1" parent="1" source="card_p1_overview_111" target="card_p1_overview_117"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_142" value="Retrieve Knowledge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#8B5CF6;" edge="1" parent="1" source="card_p1_overview_117" target="card_p1_overview_118"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_143" value="Invoke Tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#8B5CF6;" edge="1" parent="1" source="card_p1_overview_117" target="card_p1_overview_119"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_144" value="Inference Demand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#10B981;" edge="1" parent="1" source="card_p1_overview_117" target="card_p1_overview_123"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_145" value="Dispatch GPUs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#10B981;" edge="1" parent="1" source="card_p1_overview_123" target="card_p1_overview_124"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_146" value="Enforce Inspection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#D97706;" edge="1" parent="1" source="card_p1_overview_128" target="card_p1_overview_129"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_p1_overview_147" value="Trigger Agility Loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#D97706;" edge="1" parent="1" source="card_p1_overview_130" target="card_p1_overview_131"><mxGeometry relative="1" as="geometry" /></mxCell>
