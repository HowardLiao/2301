<mxfile host="app.diagrams.net" modified="2026-11-19T09:00:00.000Z" agent="HermesAgent" version="24.0.0" type="device">
  <diagram id="e2e-architecture" name="端到端使用者旅程與全景系統架構拓撲">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== HEADER BANNER ==================== -->
        <mxCell id="title_banner" value="&lt;b style='font-size:20px;'&gt;企業級主權 AI 平台：從使用者端到端調用生命週期 (左) 與 完整系統架構拓撲 (右)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px; color:#4B5563;'&gt;Enterprise Sovereign AI Platform: End-to-End User Request Lifecycle &amp; Full System Architecture Topology&lt;/span&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;align=center;verticalAlign=middle;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2320" height="70" as="geometry" />
        </mxCell>

        <!-- ============================================================================================== -->
        <!-- LEFT PANEL: 端到端使用者請求生命週期 (USER-TO-OUTPUT DETAILED LIFECYCLE)                       -->
        <!-- ============================================================================================== -->
        <mxCell id="panel_left" value="&lt;b style='font-size:16px; color:#1E3A8A;'&gt;【左側：使用者端到端調用詳細生命週期 (End-to-End User Request Lifecycle)】&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;dashed=1;dashPattern=5 5;strokeWidth=2.5;strokeColor=#2563EB;fillColor=#F0F7FF;verticalAlign=top;align=left;spacingLeft=25;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1120" height="1240" as="geometry" />
        </mxCell>

        <!-- Step 1: User & Input -->
        <mxCell id="flow_step1" value="&lt;b&gt;步驟 1: 終端輸入與請求發起 (User Prompt / Payload Ingestion)&lt;/b&gt;&lt;br&gt;&lt;div align='left' style='padding-left:8px; font-size:11px;'&gt;• 業務/研發人員透過 Web 介面輸入 Prompt，或產線 MES 自動觸發 API&lt;br&gt;• 攜帶企業身份憑證 (SSO JWT Token) 與業務上下文 (Context / RAG 文檔)&lt;br&gt;• 格式符合標準 OpenAI 兼容協議格式 (`/v1/chat/completions`)&lt;/div&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;fontSize=12;fontColor:#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- Step 2: Gateway & Auth -->
        <mxCell id="flow_step2" value="&lt;b&gt;步驟 2: 邊界安全防護與身份鑑權 (Gateway Ingress &amp; Auth Verification)&lt;/b&gt;&lt;br&gt;&lt;div align='left' style='padding-left:8px; font-size:11px;'&gt;• API Gateway (Envoy) 進行 TLS 雙向加密終結，阻絕公網嗅探&lt;br&gt;• 企業 IDP (OAuth2/Keycloak) 驗證 JWT 簽章與部門 RBAC 調用權限&lt;br&gt;• WAF 深度流量清洗：攔截 Prompt Injection (提示詞注入) 與惡意腳本&lt;/div&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;fontSize=12;fontColor:#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- Step 3: Semantic Cache -->
        <mxCell id="flow_step3" value="&lt;b&gt;步驟 3: 語意快取比對 (Semantic Cache Lookup - &amp;lt;10ms 判斷)&lt;/b&gt;&lt;br&gt;&lt;div align='left' style='padding-left:8px; font-size:11px;'&gt;• 計算 Prompt Embedding 向量，於 Redis Vector 快取中進行相似度比對&lt;br&gt;• 若 Cosine 相似度 &amp;gt; 0.95 (Cache Hit) ➜ &lt;b style='color:#16A34A;'&gt;直接回傳快取結果 (成本 0 元, 延遲 &amp;lt;20ms)&lt;/b&gt;&lt;br&gt;• 若 Cache Miss ➜ 進入核心智能路由分流管線&lt;/div&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;fontSize=12;fontColor:#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- Step 4: Intent & Complexity Scoring -->
        <mxCell id="flow_step4" value="&lt;b&gt;步驟 4: 語意意圖分類與複雜度打分 (Lightweight Scorer - &amp;lt;15ms)&lt;/b&gt;&lt;br&gt;&lt;div align='left' style='padding-left:8px; font-size:11px;'&gt;• 輕量化 BERT 分類器快速計算難度係數 (Scoring 0.0 ~ 1.0)&lt;br&gt;• 判定任務類型：常規問答、代碼生成、數學邏輯、跨語系或超長上下文&lt;br&gt;• 閾值分流：Score &amp;le; 0.65 判定為常規任務；Score &amp;gt; 0.65 判定為高難度任務&lt;/div&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;fontSize=12;fontColor:#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="560" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- Step 5: DLP Sanitization -->
        <mxCell id="flow_step5" value="&lt;b&gt;步驟 5: 敏感專利與機密資料動態脫敏 (DLP In-Flight Sanitization)&lt;/b&gt;&lt;br&gt;&lt;div align='left' style='padding-left:8px; font-size:11px;'&gt;• 正則與 NER 引擎動態掃描：身份證、信用卡、客戶料號、伺服器 IP&lt;br&gt;• 執行在地遮罩替換 (Token Masking: `CLIENT_ALPHA`, `SECRET_01`)&lt;br&gt;• 記錄實體映射表至記憶體 Session，確保明文 100% 絕不出廠直傳公網&lt;/div&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;fontSize=12;fontColor:#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="690" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- Step 6: Dual Route Dispatch -->
        <mxCell id="flow_step6" value="&lt;b&gt;步驟 6: 雙軌路由動態分發 (Dual-Track Model Dispatch)&lt;/b&gt;&lt;br&gt;&lt;div align='left' style='padding-left:8px; font-size:11px;'&gt;• &lt;b style='color:#16A34A;'&gt;【軌道 A (70% 負載)】&lt;/b&gt; 派發至地端私有 vLLM (Llama-3/Mistral/Qwen)，零外洩、零公網依賴&lt;br&gt;• &lt;b style='color:#D97706;'&gt;【軌道 B (30% 負載)】&lt;/b&gt; 脫敏後經 Dedicated 專線派發至 AWS Bedrock / GCP Vertex AI&lt;br&gt;• &lt;b style='color:#DB2777;'&gt;【軌道 C (備援比價)】&lt;/b&gt; 經 OpenRouter (openrouter/auto) 進行多雲即時動態比價容錯&lt;/div&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;fontSize=12;fontColor:#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="820" width="500" height="110" as="geometry" />
        </mxCell>

        <!-- Step 7: Post-Processing & De-anonymization -->
        <mxCell id="flow_step7" value="&lt;b&gt;步驟 7: 響應校驗與實體還原 (Validation &amp; De-anonymization)&lt;/b&gt;&lt;br&gt;&lt;div align='left' style='padding-left:8px; font-size:11px;'&gt;• Guardrails 檢測：過濾模型輸出之幻覺、暴力偏見或未授權格式&lt;br&gt;• 若為外部雲端回傳：依據 Session 映射表將遮罩代碼逆向還原為真實機密資料&lt;br&gt;• 更新 Redis 語意快取，為未來相同提問預熱快取資料庫&lt;/div&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;fontSize=12;fontColor:#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="960" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- Step 8: Stream Delivery & FinOps Audit -->
        <mxCell id="flow_step8" value="&lt;b&gt;步驟 8: 流式交付與 FinOps 稽核落庫 (Streaming Output &amp; Telemetry)&lt;/b&gt;&lt;br&gt;&lt;div align='left' style='padding-left:8px; font-size:11px;'&gt;• 透過 SSE (Server-Sent Events) 打字機流式輸出至終端使用者介面&lt;br&gt;• 異步寫入 OpenTelemetry Trace：記錄路由模型、延遲 (TTFT)、成本差異&lt;br&gt;• FinOps 儀表板更新該部門 Token 額度，觸發預算警戒線時自動熔斷&lt;/div&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;fontSize=12;fontColor:#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="1090" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- Output Result Node -->
        <mxCell id="flow_output" value="&lt;b style='font-size:14px; color:#1E3A8A;'&gt;🎉 最終產出：精準解答 / 程式碼 / MES 決策指令&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#059669;'&gt;【達成指標】整體成本節降 73.8%、延遲降低 42%、數據資安 100% 合規&lt;/span&gt;" style="shape=rect;html=1;whiteSpace=wrap;rounded=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="1220" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Flow Sequential Arrows -->
        <mxCell id="f_arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;strokeColor=#2563EB;" edge="1" parent="1" source="flow_step1" target="flow_step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f_arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;strokeColor=#2563EB;" edge="1" parent="1" source="flow_step2" target="flow_step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f_arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;strokeColor=#2563EB;" edge="1" parent="1" source="flow_step3" target="flow_step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f_arr4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;strokeColor=#2563EB;" edge="1" parent="1" source="flow_step4" target="flow_step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f_arr5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;strokeColor=#2563EB;" edge="1" parent="1" source="flow_step5" target="flow_step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f_arr6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;strokeColor=#2563EB;" edge="1" parent="1" source="flow_step6" target="flow_step7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f_arr7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;strokeColor=#2563EB;" edge="1" parent="1" source="flow_step7" target="flow_step8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f_arr8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;strokeColor=#16A34A;" edge="1" parent="1" source="flow_step8" target="flow_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fast Track: Cache Hit Bypass Arrow -->
        <mxCell id="f_cache_hit" value="&lt;b style='color:#16A34A; background-color:#FFFFFF;'&gt;快取命中 (Cache Hit &amp;gt; 0.95)&lt;br&gt;&amp;lt; 20ms 極速直通&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;dashed=1;strokeColor=#16A34A;" edge="1" parent="1" source="flow_step3" target="flow_output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="480" />
              <mxPoint x="600" y="1250" />
            </Array>
          </mxGeometry>
        </mxCell>


        <!-- ============================================================================================== -->
        <!-- RIGHT PANEL: 完整系統架構拓撲 (FULL SYSTEM ARCHITECTURE TOPOLOGY)                              -->
        <!-- ============================================================================================== -->
        <mxCell id="panel_right" value="&lt;b style='font-size:16px; color:#0F172A;'&gt;【右側：企業完整系統架構拓撲 (Complete System Architecture Topology)】&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;dashed=1;dashPattern=5 5;strokeWidth=2.5;strokeColor=#475569;fillColor=#FAFAFA;verticalAlign=top;align=left;spacingLeft=25;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="1200" y="120" width="1160" height="1240" as="geometry" />
        </mxCell>

        <!-- Tier 1: Client & Presentation Tier -->
        <mxCell id="tier1" value="&lt;b&gt;Tier 1: 終端展示與客戶端層 (Client &amp; Presentation Tier)&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1230" y="170" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t1_c1" value="&lt;b&gt;企業內部 Web Portal&lt;/b&gt;&lt;br&gt;(Chatbot / 研發知識庫)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=11;" vertex="1" parent="tier1">
          <mxGeometry x="20" y="35" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="t1_c2" value="&lt;b&gt;智慧製造產線 MES/ERP&lt;/b&gt;&lt;br&gt;(設備異常警報 / 工單質檢)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=11;" vertex="1" parent="tier1">
          <mxGeometry x="280" y="35" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="t1_c3" value="&lt;b&gt;研發 IDE 插件 (VSCode)&lt;/b&gt;&lt;br&gt;(程式碼補齊 / 語意重構)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=11;" vertex="1" parent="tier1">
          <mxGeometry x="550" y="35" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="t1_c4" value="&lt;b&gt;統一內部 AI SDK&lt;/b&gt;&lt;br&gt;(OpenAI Compatible REST/gRPC)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontSize=11;fontColor=#1E1B4B;" vertex="1" parent="tier1">
          <mxGeometry x="820" y="35" width="250" height="65" as="geometry" />
        </mxCell>

        <!-- Tier 2: Ingress & Security Boundary Tier -->
        <mxCell id="tier2" value="&lt;b&gt;Tier 2: 安全邊界閘道層 (Ingress &amp; Security Boundary Tier)&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="315" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t2_c1" value="&lt;b&gt;API Gateway (Envoy)&lt;/b&gt;&lt;br&gt;TLS 雙向加密 / 負載均衡 / 速率限制" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=11;" vertex="1" parent="tier2">
          <mxGeometry x="20" y="35" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="t2_c2" value="&lt;b&gt;企業 SSO / AD 鑑權中心&lt;/b&gt;&lt;br&gt;OAuth2 / JWT 驗證 / 部門 RBAC" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=11;" vertex="1" parent="tier2">
          <mxGeometry x="370" y="35" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="t2_c3" value="&lt;b&gt;企業級 WAF &amp;amp; 流量清洗&lt;/b&gt;&lt;br&gt;DDoS 緩解 / 惡意 Prompt 注入防禦" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=11;" vertex="1" parent="tier2">
          <mxGeometry x="730" y="35" width="340" height="65" as="geometry" />
        </mxCell>

        <!-- Tier 3: Howard Intelligent Routing Engine Tier -->
        <mxCell id="tier3" value="&lt;b&gt;Tier 3: Howard 智慧模型路由中樞 (Intelligent Routing &amp; Orchestration Engine - K8s)&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="1230" y="460" width="1100" height="300" as="geometry" />
        </mxCell>
        <mxCell id="t3_c1" value="&lt;b&gt;異步路由調度引擎 (FastAPI / Go Core)&lt;/b&gt;&lt;br&gt;高並發 Session 狀態維護與雙軌調度" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="tier3">
          <mxGeometry x="20" y="40" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t3_c2" value="&lt;b&gt;語意意圖 &amp;amp; 複雜度評分引擎&lt;/b&gt;&lt;br&gt;BERT 輕量模型 (&amp;lt;15ms 判定 70% 常規 vs 30% 難題)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=11;" vertex="1" parent="tier3">
          <mxGeometry x="370" y="40" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t3_c3" value="&lt;b&gt;DLP 機密數據動態脫敏閘道&lt;/b&gt;&lt;br&gt;專利/PII 自動遮罩與 Session 實體映射" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontColor=#991B1B;" vertex="1" parent="tier3">
          <mxGeometry x="730" y="40" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t3_c4" value="&lt;b&gt;Redis 提示語意快取 (Semantic Cache)&lt;/b&gt;&lt;br&gt;向量距離相似度搜尋 (&amp;gt;0.95 直通回傳)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=11;" vertex="1" parent="tier3">
          <mxGeometry x="20" y="135" width="320" height="75" as="geometry" />
        </mxCell>
        <mxCell id="t3_c5" value="&lt;b&gt;斷網熔斷與自動降級控制器 (Circuit Breaker)&lt;/b&gt;&lt;br&gt;海纜中斷/專線延遲過高 ➜ 100% 切換地端算力" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="tier3">
          <mxGeometry x="370" y="135" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="t3_c6" value="&lt;b&gt;響應校驗與實體還原引擎 (De-anonymizer)&lt;/b&gt;&lt;br&gt;Guardrails 安全合規校驗 &amp;amp; 遮罩反向還原" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=11;" vertex="1" parent="tier3">
          <mxGeometry x="730" y="135" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="t3_c7" value="&lt;b&gt;FinOps 預算動態熔斷器&lt;/b&gt;&lt;br&gt;各部門 Token 消耗即時額度防爆" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="tier3">
          <mxGeometry x="20" y="230" width="1050" height="50" as="geometry" />
        </mxCell>

        <!-- Tier 4: Execution Compute Tier (Dual Tracks) -->
        <mxCell id="tier4" value="&lt;b&gt;Tier 4: 模型推論執行算力層 (Execution Compute Tier - Dual Tracks)&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#16A34A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="1230" y="785" width="1100" height="295" as="geometry" />
        </mxCell>

        <!-- Sub-Track 4A: On-Premise -->
        <mxCell id="t4_subA" value="&lt;b style='color:#166534;'&gt;【軌道 A：地端私有算力中心 (Local GPU Pods - 承載 70% 負載)】&lt;/b&gt;&lt;br&gt;數據 100% 留在光寶內部機房，零資安外洩風險" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="tier4">
          <mxGeometry x="20" y="40" width="510" height="235" as="geometry" />
        </mxCell>
        <mxCell id="t4a_c1" value="&lt;b&gt;vLLM 高併發推理服務叢集&lt;/b&gt;&lt;br&gt;部署模型：Llama-3-70B / 8B, Qwen 2.5 32B, Mistral&lt;br&gt;PagedAttention 技術支援高並發低延遲吞吐" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="t4_subA">
          <mxGeometry x="15" y="45" width="480" height="75" as="geometry" />
        </mxCell>
        <mxCell id="t4a_c2" value="&lt;b&gt;Milvus / Qdrant 企業私有向量資料庫&lt;/b&gt;&lt;br&gt;內部研發圖紙、專利文檔與產線 SOP 向量檢索 (Local RAG)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="t4_subA">
          <mxGeometry x="15" y="135" width="480" height="80" as="geometry" />
        </mxCell>

        <!-- Sub-Track 4B: Cloud & Proxy -->
        <mxCell id="t4_subB" value="&lt;b style='color:#78350F;'&gt;【軌道 B &amp;amp; C：公有雲旗艦模型群 &amp;amp; OpenRouter 代理 (承載 30% 難題負載)】&lt;/b&gt;&lt;br&gt;出廠前通過 DLP 脫敏，專注極致推理與跨模型比價" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="tier4">
          <mxGeometry x="560" y="40" width="520" height="235" as="geometry" />
        </mxCell>
        <mxCell id="t4b_c1" value="&lt;b&gt;AWS Bedrock (Dedicated DirectConnect 專線)&lt;/b&gt;&lt;br&gt;Claude 3.5 Sonnet / Claude 3.5 Haiku 專利複雜分析" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=11;" vertex="1" parent="t4_subB">
          <mxGeometry x="15" y="45" width="490" height="55" as="geometry" />
        </mxCell>
        <mxCell id="t4b_c2" value="&lt;b&gt;Google Vertex AI &amp;amp; Azure OpenAI (多雲備援)&lt;/b&gt;&lt;br&gt;Gemini 1.5 Pro (超長上下文) / GPT-4o 跨雲容錯" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=11;" vertex="1" parent="t4_subB">
          <mxGeometry x="15" y="110" width="490" height="55" as="geometry" />
        </mxCell>
        <mxCell id="t4b_c3" value="&lt;b&gt;OpenRouter / MixRoute (市場中立聚合代理 - openrouter/auto)&lt;/b&gt;&lt;br&gt;55T+ tokens/週即時性價比評分、動態跨商容錯 (DeepSeek/Together/Groq)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=2;fontSize=11;fontColor=#831843;" vertex="1" parent="t4_subB">
          <mxGeometry x="15" y="172" width="490" height="55" as="geometry" />
        </mxCell>

        <!-- Tier 5: Observability & Governance Tier -->
        <mxCell id="tier5" value="&lt;b&gt;Tier 5: 全域可觀測性、FinOps 與資安稽核層 (Observability, FinOps &amp; Governance Tier)&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1100" width="1100" height="180" as="geometry" />
        </mxCell>
        <mxCell id="t5_c1" value="&lt;b&gt;Prometheus + Grafana 監控看板&lt;/b&gt;&lt;br&gt;• 70/30 即時分流佔比&lt;br&gt;• P95 / P99 延遲追蹤&lt;br&gt;• 地端 GPU 顯存使用率與佇列" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=11;" vertex="1" parent="tier5">
          <mxGeometry x="20" y="40" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t5_c2" value="&lt;b&gt;OpenTelemetry + ELK 稽核中樞&lt;/b&gt;&lt;br&gt;• 全生命週期分散式 Trace 鏈路&lt;br&gt;• 使用者身份與模型調用關聯記錄&lt;br&gt;• 符合 ISO 27001 / SOC 2 稽核合規" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=11;" vertex="1" parent="tier5">
          <mxGeometry x="380" y="40" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t5_c3" value="&lt;b&gt;FinOps 成本分析與自動熔斷系統&lt;/b&gt;&lt;br&gt;• 各事業群 (BU) 即時 Token 成本攤提&lt;br&gt;• 節省成本效益報告 (相較純雲端節省 73.8%)&lt;br&gt;• 預算超支即時 Email/Slack 警報與限速" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#78350F;" vertex="1" parent="tier5">
          <mxGeometry x="750" y="40" width="330" height="120" as="geometry" />
        </mxCell>

        <!-- ============================================================================================== -->
        <!-- MAPPING & TRACEABILITY CONNECTORS (BETWEEN LEFT LIFECYCLE & RIGHT TOPOLOGY)                    -->
