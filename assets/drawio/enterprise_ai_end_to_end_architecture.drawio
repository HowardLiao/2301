        <mxCell id="link_step1_t1" value="對應 Tier 1 終端環境" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeWidth=1.5;strokeColor=#9CA3AF;fontSize=11;" edge="1" parent="1" source="flow_step1" target="tier1">
          <mxGeometry relative="1" as="geometry" />
