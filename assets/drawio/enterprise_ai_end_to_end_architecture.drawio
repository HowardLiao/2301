        <mxCell id="link_step4_t3" value="由 Tier 3 核心中樞調度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeWidth=1.5;strokeColor=#2563EB;fontSize=11;" edge="1" parent="1" source="flow_step4" target="tier3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link_step6_t4" value="執行 Tier 4 雙軌算力" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeWidth=1.5;strokeColor=#16A34A;fontSize=11;" edge="1" parent="1" source="flow_step6" target="tier4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link_step8_t5" value="寫入 Tier 5 稽核與監控" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="flow_step8" target="tier5">
          <mxGeometry relative="1" as="geometry" />
