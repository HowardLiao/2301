        <mxCell id="c_scorer" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;語意意圖 &amp;amp; 難度評分引擎&lt;/b&gt;&lt;br&gt;輕量 BERT / Embedding 快速分類器&lt;br&gt;(&amp;lt;15ms 判定 70% 常規 vs 30% 難題)" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;" vertex="1" parent="node_router">
